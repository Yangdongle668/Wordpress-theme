# ═══════════════════════════════════════════════════════════════════════════
# Docker-compose top-level environment
# Copy to .env (alongside docker-compose.yml) before first deploy.
# Values are read by deploy/init-letsencrypt.sh and can be referenced
# inside compose via ${VAR}.
# ═══════════════════════════════════════════════════════════════════════════

# Canonical apex domain
DOMAIN=07691688.xyz

# Admin email for Let's Encrypt expiry notifications
LETSENCRYPT_EMAIL=admin@07691688.xyz

# Staging vs. production Let's Encrypt endpoint.
# Keep STAGING=1 while testing the deploy to avoid hitting LE rate limits.
# Flip to 0 once HTTP-01 is working cleanly, then re-run init-letsencrypt.sh.
STAGING=0
