# ═══════════════════════════════════════════════════════════════════════════
# BatteryCo form service — environment configuration
# Copy to .env (which is gitignored) and fill real values before `npm start`.
# ═══════════════════════════════════════════════════════════════════════════

# ─── HTTP server ─────────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
NODE_ENV=production

# Trust Nginx X-Forwarded-For so rate-limit + logs see the real client IP.
# 1 = trust the first proxy (standard nginx setup). 0 disables.
TRUST_PROXY=1

# Comma-separated list of origins allowed via CORS (empty = same-origin only).
# Example: CORS_ORIGINS=https://www.example.com,https://staging.example.com
CORS_ORIGINS=

# ─── Rate limiting ───────────────────────────────────────────────────────
# Requests per window per IP. Prevents spam without blocking real traffic.
RATE_LIMIT_WINDOW_MS=900000        # 15 minutes
RATE_LIMIT_MAX=12                  # 12 submissions per IP per window

# ─── File uploads (careers resume) ───────────────────────────────────────
MAX_UPLOAD_BYTES=10485760          # 10 MB
UPLOAD_DIR=./uploads

# ─── Submission logging (JSON lines) ─────────────────────────────────────
LOG_DIR=./logs
LOG_SUBMISSIONS=true

# ─── SMTP (Nodemailer) ───────────────────────────────────────────────────
# Any SMTP provider works: Amazon SES, Mailgun, Postmark, SendGrid, or a
# self-hosted Postfix. Below is SES as an example.
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false                  # true for 465, false for 587/STARTTLS
SMTP_USER=
SMTP_PASS=

# Addresses used in emails.
MAIL_FROM="BatteryCo Website <no-reply@example.com>"
MAIL_REPLY_TO=contact@example.com

# Where each form routes its notifications (comma-separated OK).
MAIL_TO_CONTACT=contact@example.com
MAIL_TO_INQUIRY=sales@example.com
MAIL_TO_CAREERS=careers@example.com

# ─── Optional: reCAPTCHA v3 verification ─────────────────────────────────
# Leave blank to disable. When set, requests must include a `recaptchaToken`
# field and the server will verify with Google before accepting.
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5
